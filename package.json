{
  "name": "scical600",
  "version": "0.3.0",
  "private": true,
  "description": "An independent browser and native scientific calculator platform.",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "test": "node --test tests/*.test.js",
    "brand:check": "npm run build && node scripts/check-brand-independence.mjs dist",
    "deploy": "npm run build && npx --yes wrangler@latest pages deploy dist --project-name scical600 --branch main",
    "android:sync": "npm run build && node scripts/prepare-android.mjs",
    "android:debug": "npm run android:sync && node scripts/build-android.mjs",
    "ios:sync": "npm run build && node scripts/prepare-ios.mjs",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "test:browser": "npm run build && node tests/mobile-ui.browser.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "desktop:pack": "npm run build && electron-builder --config electron-builder.yml"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "electron": "44.3.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  },
  "main": "desktop/main.cjs"
}
